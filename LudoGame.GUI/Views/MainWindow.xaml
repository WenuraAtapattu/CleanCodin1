<Window x:Class="LudoGame.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LUDO-T Game Simulation" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LUDO-T Game Simulation" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="White"
                          VerticalAlignment="Center"/>
                <TextBlock Text="Clean Architecture with GUI" 
                          FontSize="14" 
                          Foreground="#BDC3C7" 
                          Margin="20,0,0,0"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Game Board Section -->
            <Border Grid.Column="0" BorderBrush="#BDC3C7" BorderThickness="2" CornerRadius="5" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Board Header -->
                    <Border Grid.Row="0" Background="#ECF0F1" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Game Board" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                            <TextBlock Text="Visual representation of the LUDO-T board" FontSize="12" Foreground="#7F8C8D"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Board Visualization -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border Padding="20" Background="#FFFFFF">
                            <Canvas x:Name="GameBoardCanvas" 
                                   Width="600" 
                                   Height="600" 
                                   Background="#F8F9FA">
                                <!-- Board cells will be drawn dynamically -->
                            </Canvas>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Game Info and Controls Section -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Game Status -->
                <Border Grid.Row="0" BorderBrush="#BDC3C7" BorderThickness="2" CornerRadius="5" Margin="0,0,0,10">
                    <Grid Padding="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Game Status" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                        <Separator Grid.Row="1" Margin="0,10"/>
                        
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Current Player:" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentPlayer}" FontSize="14" Foreground="#E74C3C"/>
                            
                            <TextBlock Text="Game Round:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding GameRound}" FontSize="14"/>
                            
                            <TextBlock Text="Game State:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding GameState}" FontSize="14"/>
                            
                            <TextBlock Text="Server Status:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ServerStatusText" Text="Disconnected" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Game Log -->
                <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="2" CornerRadius="5" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" Background="#ECF0F1" Padding="15">
                            <TextBlock Text="Game Log" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                        </Border>
                        
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="GameLogTextBox" 
                                    IsReadOnly="True" 
                                    TextWrapping="Wrap" 
                                    Background="#FFFFFF"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Padding="10"
                                    BorderThickness="0"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
                
                <!-- Control Buttons -->
                <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="2" CornerRadius="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Padding="15">
                        <Button x:Name="ConnectButton" 
                               Content="Connect to Server" 
                               Background="#9B59B6" 
                               Foreground="White"
                               Command="{Binding ConnectCommand}"/>
                        
                        <Button x:Name="StartButton" 
                               Content="Start Game" 
                               Background="#27AE60" 
                               Foreground="White"
                               Command="{Binding StartCommand}"/>
                        
                        <Button x:Name="PauseButton" 
                               Content="Pause" 
                               Background="#F39C12" 
                               Foreground="White"
                               Command="{Binding PauseCommand}"/>
                        
                        <Button x:Name="ResetButton" 
                               Content="Reset" 
                               Background="#E74C3C" 
                               Foreground="White"
                               Command="{Binding ResetCommand}"/>
                        
                        <Button x:Name="StepButton" 
                               Content="Step" 
                               Background="#3498DB" 
                               Foreground="White"
                               Command="{Binding StepCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Footer Section -->
        <Border Grid.Row="2" Background="#34495E" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="© 2026 Clean Coding Assignment" 
                          Foreground="#BDC3C7" 
                          FontSize="12"
                          VerticalAlignment="Center"/>
                <TextBlock Text="|" 
                          Foreground="#7F8C8D" 
                          Margin="10,0"
                          VerticalAlignment="Center"/>
                <TextBlock Text="Maintains Clean Architecture Principles" 
                          Foreground="#BDC3C7" 
                          FontSize="12"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
